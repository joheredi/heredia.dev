---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { SITE } from "../config";

const posts = (await getCollection("posts", ({ data }) => !(import.meta.env.PROD && data.draft)))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title={SITE.title} description={SITE.description}>
  <div class="wrap">
    <h1 class="visually-hidden-heading">Posts</h1>
    <PostList posts={posts} />
  </div>
</Base>

<style>
  /* The site name in the header reads as the page title; keep an h1 for structure. */
  .visually-hidden-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
