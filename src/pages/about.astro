---
import Base from "../layouts/Base.astro";
import { SITE } from "../config";

const description = `About ${SITE.author}.`;
---

<Base title={`About — ${SITE.title}`} description={description}>
  <div class="wrap">
    <h1 class="page-title">About</h1>
    <div class="prose">
      <p>
        I'm Jose Manuel Heredia Hidalgo. I work on developer tooling in TypeScript, mostly
        code generation: the emitters and compilers that turn an API description into a client
        library somebody else has to live with.
      </p>
      <p>
        It's a strange corner of the field. The output is code no human wrote but plenty of
        humans read, which makes naming, ergonomics, and error messages load-bearing in ways
        they aren't when you're writing for yourself. I write here when something takes me long
        enough to work out that the explanation seems worth keeping, usually with a diagram you
        can poke at.
      </p>
      <p>
        Code on <a href={SITE.github} rel="me noopener">GitHub</a>, or reach me at{" "}
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. Corrections welcome.
      </p>
    </div>
  </div>
</Base>
