---
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== "/" && path.startsWith(href));
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__name" href="/">heredia.dev</a>
    <nav class="site-nav" aria-label="Primary">
      <a href="/" aria-current={path === "/" ? "page" : undefined}>Posts</a>
      <a href="/about/" aria-current={isCurrent("/about/") ? "page" : undefined}>About</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
</header>
